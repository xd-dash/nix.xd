#!/usr/bin/env bash
set -euo pipefail
die() { echo "Workspace error: $*" >&2; exit 1; }
action=${1:-open}
root=${NIX_XD_WORKSPACE_ROOT:-$HOME/workspace}
repo=${NIX_XD_WORKSPACE_REPO:-xd-dash/nix.xd}
version=${NIX_XD_WORKSPACE_VERSION:-$(date +%Y%m%d)}
base=${NIX_XD_WORKSPACE_BASE:-}
[[ $action == open || $action == plan || $action == path || $action == clean || $action == clean-plan ]] || die 'Expected open, plan, path, clean or clean-plan'
[[ $root == /* && $root != / ]] || die 'Root must be an absolute workspace directory'
[[ $version =~ ^[0-9]{8}$ ]] || die 'Version must be YYYYMMDD'
year=$((10#${version:0:4})); month=$((10#${version:4:2})); day=$((10#${version:6:2}))
[[ $year -ge 1970 && $month -ge 1 && $month -le 12 ]] || die 'Invalid calendar date'
days=(31 28 31 30 31 30 31 31 30 31 30 31)
if (( year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) )); then days[1]=29; fi
(( day >= 1 && day <= days[month-1] )) || die 'Invalid calendar date'
case "$repo" in
  https://*|ssh://*|git@*:*|file://*) url=$repo ;;
  *) [[ $repo =~ ^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$ ]] || die 'Use owner/repo or a Git URL'
     url="https://github.com/$repo.git" ;;
esac
name=${repo##*/}; name=${name##*:}; name=${name%.git}
[[ $name =~ ^[A-Za-z0-9][A-Za-z0-9._-]{0,63}$ ]] || die 'Invalid repository name'
target="${root%/}/$name$version"
branch="v$version"
if [[ $action == clean || $action == clean-plan ]]; then
  [[ -d $root ]] || die 'Workspace root does not exist'
  root=$(cd "$root" && pwd -P)
  target="$root/$name$version"
  [[ -d $target/.git && ! -L $target ]] || die "Create the retained checkout first: $target"
  count=0
  current=$(pwd -P)
  for candidate in "$root/$name"*; do
    [[ -d $candidate && ! -L $candidate ]] || continue
    leaf=${candidate##*/}
    [[ $candidate != "$target" ]] || continue
    selected=0
    case "$leaf" in
      "$name"|"$name-fresh"|"$name-consolidated") selected=1 ;;
      *) suffix=${leaf#"$name"}
         if [[ $suffix =~ ^[0-9]{8}$ && $suffix < $version ]]; then selected=1; fi ;;
    esac
    [[ $selected == 1 ]] || continue
    case "$current/" in "$candidate/"*) die "Run cleanup from the retained checkout, not $candidate" ;; esac
    [[ ! -e $candidate.lock ]] || die "Workspace operation holds $candidate.lock"
    printf 'WORKSPACE_REMOVE=%s\n' "$candidate"
    if [[ $action == clean ]]; then
      # Read-only dependency cache directories prevent unlinking their contents.
      find "$candidate" -type d -exec chmod u+rwx {} \;
      if [[ -f $candidate/.git ]]; then
        git -C "$candidate" worktree remove --force "$candidate"
      else
        rm -rf -- "$candidate"
      fi
      [[ ! -e $candidate && ! -L $candidate ]] || die "Cleanup left a directory behind: $candidate"
    fi
    count=$((count+1))
  done
  printf 'WORKSPACE_CLEAN_RESULT=passed action=%s count=%s retained=%s\n' "$action" "$count" "$target"
  exit 0
fi
git check-ref-format --branch "$branch" >/dev/null
if [[ -n $base ]]; then git check-ref-format "refs/heads/$base" >/dev/null; fi
if [[ $action == path ]]; then printf '%s\n' "$target"; exit; fi
printf 'WORKSPACE_PATH=%s\nWORKSPACE_BRANCH=%s\n' "$target" "$branch"
[[ $action != plan ]] || exit 0
mkdir -p "$root"
lock="$target.lock"
mkdir "$lock" 2>/dev/null || die "Another workspace operation holds $lock"
tmp=
cleanup() { [[ -z $tmp ]] || rm -rf -- "$tmp"; rmdir "$lock"; }
trap cleanup EXIT
if [[ -e $target || -L $target ]]; then
  [[ -d $target/.git && ! -L $target ]] || die "Destination is not an independent checkout: $target"
  actual=$(git -C "$target" remote get-url origin)
  [[ $actual == "$url" ]] || die 'Existing checkout has a different origin'
  current=$(git -C "$target" symbolic-ref --short HEAD) || die 'Checkout has detached HEAD'
  [[ $current == "$branch" ]] || die "Expected version branch $branch; current branch is $current"
  echo WORKSPACE_RESULT=reused
else
  tmp=$(mktemp -d "$root/.$name$version.XXXXXX")
  args=(clone --no-checkout)
  [[ -z $base ]] || args+=(--branch "$base")
  git "${args[@]}" -- "$url" "$tmp"
  if [[ -n $base ]]; then start="refs/remotes/origin/$base"; else start=refs/remotes/origin/HEAD; fi
  if git -C "$tmp" show-ref --verify --quiet "refs/heads/$branch"; then
    git -C "$tmp" switch "$branch"
  elif git -C "$tmp" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
    git -C "$tmp" switch --track -c "$branch" "origin/$branch"
  else
    git -C "$tmp" switch --no-track -c "$branch" "$start"
  fi
  mv "$tmp" "$target"
  tmp=
  echo WORKSPACE_RESULT=created
fi
printf 'Enter: cd "%s"\n' "$target"
