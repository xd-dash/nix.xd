#!/usr/bin/env bash
set -Eeuo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
cd "$root"
machine="${NIX_XD_MACHINE:-podman-machine-default}"
writer="${NIX_XD_SCOPE:-nix-xd-smoke-podman}"
reader="${NIX_XD_READER_SCOPE:-$writer-reader}"
age_source="$HOME/.config/nix.xd/age/keys.txt"
flake=/workspaces/nix-alpine/nix-alpine/toolbox
[[ "$writer" =~ ^[a-z][a-z0-9-]{0,39}$ && "$reader" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || exit 2
[[ "$writer" != "$reader" ]] || { echo 'Writer and reader scopes must differ' >&2; exit 2; }
step=preflight
completed=()
probe_created=0
finish() {
  local rc=$?
  trap - EXIT
  if (( probe_created )); then
    podman --connection "$machine" exec "$writer" rm -f /workspaces/.private/sops/.qualification-probe.enc.json >/dev/null 2>&1 || :
  fi
  if (( rc == 0 )); then
    printf 'QUALIFICATION_RESULT=PASS scopes=%s,%s gates=%s\n' "$writer" "$reader" "${completed[*]}"
  else
    printf 'QUALIFICATION_RESULT=FAIL gate=%s exit=%s gates_completed=%s\n' "$step" "$rc" "${completed[*]}" >&2
  fi
  exit "$rc"
}
trap finish EXIT
gate() {
  step="$1"
  shift
  printf '\n========== GATE=%s START ==========\n' "$step"
  "$@"
  completed+=("$step")
  printf '========== GATE=%s PASS ==========\n' "$step"
}
guest() {
  local scope="$1"; shift
  podman --connection "$machine" exec "$scope" "$@"
}
security() {
  local scope="$1"; shift
  guest "$scope" nix develop "$flake#security" -c "$@"
}
bootstrap_scope() {
  local scope="$1" access="$2"
  make --no-print-directory bootstrap PROVIDER=podman \
    MACHINE="$machine" SCOPE="$scope" WORKSPACE_ACCESS="$access" \
    AGE_SOURCE="$age_source" WORKSPACES="$root"
}
init_age() {
  bash "$root/bin/nix-xd-age-setup"
  [[ -f "$age_source" ]] || { echo 'No age identity' >&2; return 1; }
}
sync_smoke() {
  bash "$root/bin/nix-xd-sync" xd-dash/smoke codex/ghxd-minimal-sops \
    "$root" compositions/smoke
}
verify_mounts() {
  local scope access
  for scope in "$writer" "$reader"; do
    access=rw
    [[ "$scope" == "$reader" ]] && access=ro
    guest "$scope" /bin/bash -ec '
      set -euo pipefail
      test -r /run/secrets/age/keys.txt
      test ! -w /run/secrets/age/keys.txt
      test "$(id -u)" = 1000 && test "$(id -g)" = 1000
      test -r /workspaces/compositions/smoke/go.mod
      test -w /nix
      if [[ "$1" == ro ]]; then
        test ! -w /workspaces
      else
        test -w /workspaces
      fi
      stat -c "AGE_IDENTITY mode=%a owner=%u:%g" /run/secrets/age/keys.txt
      stat -c "WORKSPACE mode=%a owner=%u:%g" /workspaces
    ' bash "$access"
  done
}
smoke_test_build() {
  security "$writer" bash /workspaces/compositions/smoke/tools/nix-alpine.sh test
  security "$writer" bash /workspaces/compositions/smoke/tools/nix-alpine.sh vet
  security "$writer" bash /workspaces/compositions/smoke/tools/nix-alpine.sh build
  guest "$writer" test -x /workspaces/.smoke-state/bin/smoke
  guest "$writer" /bin/bash -ec '
    /workspaces/.smoke-state/bin/smoke commands | grep -qi logmash && {
      echo "Minimal Smoke binary unexpectedly includes Logmash" >&2; exit 1;
    }
    echo "Minimal ghxd Smoke binary compiled without Logmash"
  '
}
cache_snapshot() {
  guest "$writer" /bin/bash -ec '
    set -euo pipefail
    [[ "$GOMODCACHE" == /workspaces/.cache/go/mod ]]
    [[ "$GOCACHE" == /workspaces/.cache/go/build ]]
    test -d "$GOMODCACHE" && test -d "$GOCACHE"
    test -w "$GOMODCACHE" && test -w "$GOCACHE"
    printf "GO_CACHE module=%s build=%s\n" "$GOMODCACHE" "$GOCACHE"
    find "$GOMODCACHE" -type f | wc -l
  '
}
store_publish() {
  out="$(guest "$writer" nix build --no-link --print-out-paths "$flake#devShells.aarch64-linux.security")"
  [[ "$out" == /nix/store/* && "$out" != *$'\n'* ]] || { echo 'Unexpected Nix shell output' >&2; return 1; }
  guest "$writer" mkdir -p /workspaces/.cache/nix
  guest "$writer" nix copy --to file:///workspaces/.cache/nix "$out"
  printf 'NIX_CLOSURE_PUBLISHED=%s\n' "$out"
}
store_import() {
  guest "$reader" nix copy --no-check-sigs --from file:///workspaces/.cache/nix "$out"
  guest "$reader" nix path-info "$out"
  printf 'NIX_CLOSURE_IMPORTED=%s\n' "$out"
}
encrypt_probe() {
  guest "$writer" test ! -e /workspaces/.private/sops/.qualification-probe.enc.json
  security "$writer" /bin/bash -ec '
    set -euo pipefail
    recipient="$(age-keygen -y "$SOPS_AGE_KEY_FILE")"
    umask 077
    printf "%s\n" "{\"probe\":\"nix-xd-qualifier\"}" |
      sops encrypt --age "$recipient" --input-type json --output-type json /dev/stdin \
        > /workspaces/.private/sops/.qualification-probe.enc.json
    grep -q "\"sops\"" /workspaces/.private/sops/.qualification-probe.enc.json
    ! grep -q nix-xd-qualifier /workspaces/.private/sops/.qualification-probe.enc.json
  '
  probe_created=1
}
decrypt_probe() {
  local expected actual
  expected="$(security "$writer" /bin/bash -ec '
    sops decrypt --input-type json --output-type json /workspaces/.private/sops/.qualification-probe.enc.json | sha256sum
  ')"
  actual="$(security "$reader" /bin/bash -ec '
    sops decrypt --input-type json --output-type json /workspaces/.private/sops/.qualification-probe.enc.json | sha256sum
  ')"
  [[ "${expected%% *}" == "${actual%% *}" ]] || { echo 'Different age decryption results in writer and reader' >&2; return 1; }
  printf 'SOPS_AGE_CROSS_CONTAINER_DECRYPT=PASS sha256=%s\n' "${actual%% *}"
}
refresh_writer() {
  bootstrap_scope "$writer" rw
}
cache_offline_after_refresh() {
  guest "$writer" /bin/bash -ec 'test -d "$GOMODCACHE" && test -d "$GOCACHE"'
  security "$writer" /bin/bash -ec '
    set -euo pipefail
    export GOPROXY=off GOWORK=off CGO_ENABLED=0
    cd /workspaces/compositions/smoke
    go test -count=1 ./...
  '
  printf 'GO_CACHE_OFFLINE_REUSE=PASS\n'
}

token_status() {
  if [[ ! -f "$root/.private/sops/ghxd.enc.json" ]]; then
    printf 'GHXD_CREDENTIAL=PENDING_DEVICE_AUTHORIZATION (synthetic SOPS verification already qualified)\n'
    return 0
  fi
  for scope in "$writer" "$reader"; do
    security "$scope" /workspaces/.smoke-state/bin/smoke ghxd status
  done
  printf 'GHXD_CREDENTIAL_CROSS_CONTAINER=PASS\n'
}
printf 'QUALIFICATION=GHXD_MINIMAL MACHINE=%s WRITER=%s READER=%s\n' "$machine" "$writer" "$reader"
gate age-init init_age
gate smoke-source sync_smoke
gate writer-bootstrap bootstrap_scope "$writer" rw
gate reader-bootstrap bootstrap_scope "$reader" ro
gate mount-access verify_mounts
gate smoke-minimal smoke_test_build
gate go-cache cache_snapshot
gate closure-publish store_publish
gate closure-import store_import
gate encrypt-synthetic encrypt_probe
gate decrypt-synthetic decrypt_probe
gate writer-refresh refresh_writer
gate go-cache-offline cache_offline_after_refresh
gate mount-after-refresh verify_mounts
gate ghxd-token-status token_status
