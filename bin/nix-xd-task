#!/usr/bin/env bash
set -euo pipefail

action="${1:?Action required}"
provider="${NIX_XD_PROVIDER:-podman}"
scope="${NIX_XD_SCOPE:-nix-xd-arm}"
system="${NIX_XD_SYSTEM:-aarch64-linux}"
root="${NIX_XD_WORKSPACES:-$HOME/workspace/nix.xd}"
workspace_mode="${NIX_XD_WORKSPACE_MODE:-bind}"
checkout="${NIX_XD_CHECKOUT:-}"
flake="${NIX_XD_FLAKE:-.}"
target="${NIX_XD_TARGET:-}"
args="${NIX_XD_ARGS:-}"
cmd="${NIX_XD_CMD:-nix --version}"

fail() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$provider" == podman || "$provider" == container ]] || fail "Unsupported provider: $provider"
[[ "$scope" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || fail "Invalid scope"
[[ "$workspace_mode" == bind || "$workspace_mode" == staged ]] || fail "Invalid workspace mode"
[[ "$system" == aarch64-linux ]] || fail "ARM runner requires aarch64-linux"
runtime="$provider"
if [[ "$provider" == container ]]; then
  [[ "$(uname -s)" == Darwin ]] || fail "Apple container requires macOS"
fi
command -v "$runtime" >/dev/null || fail "Runtime not installed: $runtime"

inside() { "$runtime" exec "$scope" "$@"; }
interactive() { "$runtime" exec -it "$scope" "$@"; }

validate_checkout() {
  [[ -n "$checkout" && "$checkout" != "." && "$checkout" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ ]] ||
    fail "CHECKOUT must be a named workspace-relative path"
  local part
  IFS=/ read -r -a parts <<< "$checkout"
  for part in "${parts[@]}"; do
    [[ "$part" != "." && "$part" != ".." && "$part" != ".git" ]] ||
      fail "CHECKOUT contains a reserved path segment"
  done
}
stage() (
  [[ "$workspace_mode" == staged ]] || fail "Staging disabled with WORKSPACE_MODE=bind; run Nix directly against the mounted workspace"
  validate_checkout
  [[ -d "$root" ]] || fail "Workspace root does not exist: $root"
  local src="$root/$checkout" root_real src_real tmp
  root_real="$(realpath "$root")"
  src_real="$(realpath "$src")"
  [[ "$src_real" == "$root_real/"* ]] || fail "Checkout resolves outside WORKSPACES: $src"
  [[ -e "$src_real/.git" ]] || fail "Missing Git checkout metadata: $src_real/.git"
  [[ -z "$(git -C "$src_real" status --porcelain --untracked-files=no)" ]] ||
    fail "Tracked changes in $src_real; commit before staging"
  tmp="$(mktemp -d)"
  trap 'rm -rf "$tmp"' EXIT
  # Stage only committed files; no .git, credentials or unrelated host directories.
  git -C "$src_real" archive HEAD | tar -xf - -C "$tmp"
  # A previous container cp may leave the staged checkout root-owned.
  # Run only destination preparation/ownership repair as container root.
  # All Nix operations continue as nixuser.
  "$runtime" exec --user 0 "$scope" /bin/bash -c '
    set -euo pipefail
    checkout=$1
    current=/workspaces
    [[ ! -L "$current" && ( ! -e "$current" || -d "$current" ) ]] ||
      { echo "Unsafe workspace root" >&2; exit 1; }
    install -d -m 0755 -o 1000 -g 1000 "$current"
    IFS=/ read -r -a parts <<< "$checkout"
    for part in "${parts[@]}"; do
      current="$current/$part"
      [[ ! -L "$current" && ( ! -e "$current" || -d "$current" ) ]] ||
        { echo "Unsafe staged destination: $current" >&2; exit 1; }
      mkdir -p "$current"
    done
    # This path has been checked segment by segment, and is not /workspaces.
    chown -R 1000:1000 "$current"
    find "$current" -mindepth 1 -maxdepth 1 -exec rm -rf -- "{}" +
  ' bash "$checkout"
  "$runtime" cp "$tmp/." "$scope:/workspaces/$checkout/"
  "$runtime" exec --user 0 "$scope" /bin/bash -c '
    set -euo pipefail
    checkout=$1
    current=/workspaces
    [[ ! -L "$current" ]] || exit 1
    IFS=/ read -r -a parts <<< "$checkout"
    for part in "${parts[@]}"; do
      current="$current/$part"
      [[ ! -L "$current" && -d "$current" ]] || exit 1
    done
    chown -R 1000:1000 "$current"
  ' bash "$checkout"
  inside test -r "/workspaces/$checkout"
  printf 'Staged %s at %s\n' "$checkout" "$(git -C "$src_real" rev-parse HEAD)"
)
flake_ref() {
  if [[ "$flake" == . ]]; then
    path="/workspaces"
  elif [[ "$flake" == /workspaces/* ]]; then
    path="$flake"
  elif [[ "$flake" =~ ^[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*$ ]]; then
    path="/workspaces/$flake"
  else
    fail "FLAKE must be a workspace-relative path"
  fi
  [[ "$path" != *..* ]] || fail "Unsafe flake path"
  [[ -z "$target" || "$target" =~ ^#[A-Za-z0-9_.-]+$ ]] || fail "TARGET must be empty or #output"
  ref="$path$target"
}
verify_workspace_mount() {
  if [[ "$provider" == container && "$workspace_mode" == bind ]]; then
    inside /bin/bash -ec 'grep -Eq "[[:space:]]/workspaces[[:space:]]" /proc/mounts && test -r /workspaces/flake.nix && test ! -w /workspaces' ||
      fail "Missing readable read-only /workspaces bind mount; bootstrap a new scope with WORKSPACE_MODE=bind"
  fi
}
nix_task() {
  verify_workspace_mount
  flake_ref
  case "$action" in
    show) inside nix --option system "$system" flake show --no-write-lock-file "$ref" ;;
    check) inside nix --option system "$system" flake check --no-write-lock-file "$ref" ;;
    build) inside nix --option system "$system" build --no-write-lock-file --no-link "$ref" ;;
    path-info) inside nix --option system "$system" path-info --no-write-lock-file "$ref" ;;
    run|qualify)
      local -a argv=()
      # Simple space-delimited arguments; use exec CMD=... for shell constructs.
      [[ -z "$args" ]] || read -r -a argv <<< "$args"
      inside nix --option system "$system" run --no-write-lock-file "$ref" -- "${argv[@]}"
      ;;
    develop) interactive nix --option system "$system" develop --no-write-lock-file "$ref" -c bash ;;
  esac
}

case "$action" in
  stage) stage ;;
  show|check|build|path-info|run|qualify|develop) nix_task ;;
  shell) interactive bash ;;
  exec) verify_workspace_mount; inside bash -c "$cmd" ;;
  store-info) inside nix store info ;;
  ps) "$runtime" ps -a ;;
  inspect) "$runtime" inspect "$scope" ;;
  *) fail "Unknown action $action" ;;
esac
