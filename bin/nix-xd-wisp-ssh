#!/usr/bin/env bash
set -Eeuo pipefail
profile="${COREOS_PROFILE:-starwisp}"
root="${COREOS_STATE_ROOT:-$PWD/.state/coreos}"
port="${COREOS_SSH_PORT:-2222}"
user="${COREOS_GUEST_USER:-wisp}"
key="${COREOS_SSH_KEY:-}"
fail() { echo "error: $*" >&2; exit 1; }
[[ "$profile" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || fail "Invalid profile"
[[ "$user" =~ ^[a-z_][a-z0-9_-]{0,31}$ ]] || fail "Invalid guest user"
[[ "$port" =~ ^[0-9]+$ ]] && (( port >= 1024 && port <= 65535 )) || fail "Invalid SSH port"
[[ -r "$key" ]] || fail "Provide COREOS_SSH_KEY"
state="$root/$profile"
[[ -f "$state/manifest.txt" ]] || fail "Missing CoreOS boot manifest"
grep -Fxq "port=$port" "$state/manifest.txt" || fail "SSH port does not match boot manifest"
case "${COREOS_VMM:-podman}" in
  podman)
    machine="${NIX_XD_MACHINE:-podman-machine-default}"
    scope_name="coreos-$profile"
    [[ "$(podman --connection "$machine" inspect "$scope_name" --format '{{.State.Running}}' 2>/dev/null)" == true ]] ||
      fail "Podman CoreOS guest is not running"
    ;;
  hvf)
    [[ -f "$state/qemu.pid" ]] && kill -0 "$(cat "$state/qemu.pid")" 2>/dev/null || fail "QEMU is not running"
    ;;
  *) fail "Unknown COREOS_VMM" ;;
esac
ready_timeout="${COREOS_READY_TIMEOUT_SEC:-900}"
retry_delay="${COREOS_READY_RETRY_SEC:-10}"
connect_timeout="${COREOS_SSH_CONNECT_TIMEOUT_SEC:-10}"
[[ "$ready_timeout" =~ ^[0-9]+$ ]] && (( ready_timeout >= 30 && ready_timeout <= 7200 )) || fail "Invalid COREOS_READY_TIMEOUT_SEC (30..7200)"
[[ "$retry_delay" =~ ^[0-9]+$ ]] && (( retry_delay >= 1 && retry_delay <= 60 )) || fail "Invalid COREOS_READY_RETRY_SEC (1..60)"
[[ "$connect_timeout" =~ ^[0-9]+$ ]] && (( connect_timeout >= 1 && connect_timeout <= 60 )) || fail "Invalid COREOS_SSH_CONNECT_TIMEOUT_SEC (1..60)"
opts=(-i "$key" -p "$port" -o BatchMode=yes -o IdentitiesOnly=yes
  -o "ConnectTimeout=$connect_timeout" -o StrictHostKeyChecking=accept-new
  -o "UserKnownHostsFile=$state/known_hosts")
start="$(date +%s)"
deadline=$(( start + ready_timeout ))
attempt=0
ready=0
last_error="$state/ssh-readiness-last-error.log"
printf 'SSH_READINESS_START profile=%s timeout_sec=%s retry_sec=%s connect_timeout_sec=%s\n' "$profile" "$ready_timeout" "$retry_delay" "$connect_timeout"
while :; do
  attempt=$((attempt + 1))
  now="$(date +%s)"
  remaining=$((deadline - now))
  (( remaining > 0 )) || break
  opts_probe=("${opts[@]}" -o "ConnectTimeout=$(( remaining < connect_timeout ? remaining : connect_timeout ))")
  if ssh "${opts_probe[@]}" "$user@127.0.0.1" true > /dev/null 2>"$last_error"; then
    ready=1
    printf 'SSH_READY profile=%s attempts=%s elapsed_sec=%s\n' "$profile" "$attempt" "$(( $(date +%s) - start ))"
    break
  fi
  now="$(date +%s)"
  printf 'SSH_WAIT profile=%s attempt=%s elapsed_sec=%s remaining_sec=%s reason=%s\n' "$profile" "$attempt" "$((now-start))" "$((deadline-now))" "$(tail -n 1 "$last_error")"
  if [[ "${COREOS_VMM:-podman}" == podman ]]; then
    [[ "$(podman --connection "$machine" inspect "$scope_name" --format '{{.State.Running}}' 2>/dev/null)" == true ]] ||
      fail "QEMU container exited during SSH readiness; see container logs"
  fi
  (( now < deadline )) || break
  nap=$((deadline - now))
  (( nap > retry_delay )) && nap=$retry_delay
  sleep "$nap"
done
(( ready == 1 )) || fail "CoreOS guest not SSH-ready after ${ready_timeout}s; last error: $(tail -n 2 "$last_error" 2>/dev/null | tr "\\n" " ")"
if ! ssh "${opts[@]}" "$user@127.0.0.1" "bash -se" > "$state/wisp.log" 2>&1 <<'GUEST'
set -Eeuo pipefail
test "$(id -u)" -ne 0
test -S "$XDG_RUNTIME_DIR/bus"
systemctl --user show-environment >/dev/null
test "$(podman info --format '{{.Host.Security.Rootless}}')" = true
unit="wisp-qualify-$$"
cleanup() {
  systemctl --user stop "$unit.service" "$unit-fail.service" "$unit-timeout.service" >/dev/null 2>&1 || true
  systemctl --user reset-failed "$unit.service" "$unit-fail.service" "$unit-timeout.service" >/dev/null 2>&1 || true
}
trap cleanup EXIT
systemd-run --user --wait --pipe --collect --unit="$unit" --property=RuntimeMaxSec=30s \
  /usr/bin/bash -c 'test -n "$INVOCATION_ID"; test "$(id -u)" -ne 0; podman info >/dev/null'
if systemd-run --user --wait --pipe --collect --unit="$unit-fail" /usr/bin/false; then
  echo "FAIL: false payload accepted" >&2; exit 1
fi
if systemd-run --user --wait --pipe --collect --unit="$unit-timeout" \
  --property=RuntimeMaxSec=2s /usr/bin/sleep 20; then
  echo "FAIL: timeout payload accepted" >&2; exit 1
fi
echo "PASS: Wisp user service, rootless Podman, failure and timeout paths"
GUEST
then
  cat "$state/wisp.log" >&2
  fail "Wisp guest qualification failed"
fi
if [[ -n "${COREOS_NIX_STORE_VOLUME:-}" ]]; then
  printf 'NIX_9P_GUEST_CHECK_START profile=%s volume=%s\n' "$profile" "$COREOS_NIX_STORE_VOLUME"
  if ! ssh "${opts[@]}" "$user@127.0.0.1" "bash -se" > "$state/nix-9p.log" 2>&1 <<'GUEST_NIX_9P'
set -Eeuo pipefail
mountpoint=/var/mnt/nixstore
findmnt -rn --mountpoint "$mountpoint" >/dev/null || {
  echo 'FAIL: 9P mount absent'; systemctl --no-pager status var-mnt-nixstore.mount || true; exit 1;
}
fs="$(findmnt -rn -o FSTYPE --mountpoint "$mountpoint")"
[[ "$fs" == 9p ]] || { echo "FAIL: Expected 9p, got $fs"; exit 1; }
opts="$(findmnt -rn -o OPTIONS --mountpoint "$mountpoint")"
[[ ",$opts," == *,ro,* ]] || { echo "FAIL: 9P mount is not read-only: $opts"; exit 1; }
test -d "$mountpoint"
test -r "$mountpoint"
test -x "$mountpoint"
entries="$(find "$mountpoint" -mindepth 1 -maxdepth 1 -print -quit)"
[[ -n "$entries" ]] || { echo 'FAIL: Nix store has no entries'; exit 1; }
printf 'PASS: NIX_9P_GUEST_MOUNT path=%s fstype=%s options=%s\n' "$mountpoint" "$fs" "$opts"
GUEST_NIX_9P
  then
    cat "$state/nix-9p.log" >&2
    fail 'Guest 9P store mount qualification failed'
  fi
  cat "$state/nix-9p.log"
  if [[ -n "${COREOS_GUEST_PROBE_IMAGE:-}" ]]; then
    probe_image="$COREOS_GUEST_PROBE_IMAGE"
    [[ "$probe_image" =~ ^[A-Za-z0-9][A-Za-z0-9._:/-]*$ ]] || fail 'Invalid COREOS_GUEST_PROBE_IMAGE'
    echo "NIX_9P_NESTED_CHECK_START image=$probe_image"
    if ! ssh "${opts[@]}" "$user@127.0.0.1" "env COREOS_GUEST_PROBE_IMAGE='$probe_image' bash -se" > "$state/nix-9p-nested.log" 2>&1 <<'GUEST_NIX_NESTED'
set -Eeuo pipefail
podman image exists "$COREOS_GUEST_PROBE_IMAGE" || {
  echo "FAIL: Guest image absent: $COREOS_GUEST_PROBE_IMAGE (pull it explicitly before qualification)"
  exit 1
}
podman run --rm --pull=never --user 1000:1000 \
  --security-opt label=disable \
  --mount type=bind,src=/var/mnt/nixstore,dst=/nix/store,ro \
  --entrypoint /bin/sh "$COREOS_GUEST_PROBE_IMAGE" -ec '
    test -d /nix/store && test -r /nix/store && test -x /nix/store
    grep -Eq " /nix/store ro(,| )" /proc/self/mountinfo
    find /nix/store -mindepth 1 -maxdepth 1 -print -quit | grep -q .
  '
echo 'PASS: NIX_9P_NESTED_PODMAN_READONLY'
GUEST_NIX_NESTED
    then
      cat "$state/nix-9p-nested.log" >&2
      fail 'Nested rootless Podman 9P read qualification failed'
    fi
    cat "$state/nix-9p-nested.log"
  fi
fi
printf "QUALIFIED profile=%s evidence=%s\n" "$profile" "$state/wisp.log"
