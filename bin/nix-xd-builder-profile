#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${NIX_XD_PROVIDER:-podman} == podman ]] || { echo 'Builder profile requires Podman' >&2;exit 2; }
scope=${NIX_XD_SCOPE:?scope}
[[ $scope =~ ^[a-z][a-z0-9-]{0,39}$ ]] || exit 2
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
if [[ $(uname -s) == Darwin ]]; then
  machine=${NIX_XD_MACHINE:?machine}
  [[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 2
  printf -v args '%q ' "$scope"
  podman machine ssh "$machine" "bash -se -- $args" < "$repo/runtime/builder-chroot-profile.sh"
else
  bash "$repo/runtime/builder-chroot-profile.sh" "$scope"
fi
