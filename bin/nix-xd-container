#!/usr/bin/env bash
set -euo pipefail

# Generic lifecycle adapter for Apple's native container CLI.
action="${1:-status}"
scope="${NIX_XD_SCOPE:-nix-xd-arm}"
image="${NIX_XD_IMAGE:-localhost/nix-xd:arm64}"
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
die() { echo "error: $*" >&2; exit 1; }
[[ "$scope" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || die "Invalid scope"
command -v container >/dev/null 2>&1 || die "Install Apple container first: make bootstrap PROVIDER=container"

case "$action" in
  machine-start) container system start --disable-kernel-install ;;
  machine-stop) container system stop ;;
  build) container build --platform linux/arm64 -t "$image" "$repo/arm" ;;
  start)
    if ! container exec "$scope" /bin/true >/dev/null 2>&1; then
      container start "$scope"
    fi
    container exec "$scope" /bin/true
    ;;
  stop) container stop "$scope" ;;
  restart)
    container stop "$scope"
    container start "$scope"
    ;;
  status)
    container system status
    container inspect "$scope"
    ;;
  logs) container logs "$scope" ;;
  shell) exec container exec -it "$scope" bash ;;
  exec|run) exec container exec "$scope" bash -c "${NIX_XD_CMD:-nix --version}" ;;
  sync|compose)
    die "Use make sync for host Git checkouts or make run FLAKE=path TARGET=#app for mounted flakes"
    ;;
  *) die "Unsupported action: $action" ;;
esac
