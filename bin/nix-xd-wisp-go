#!/usr/bin/env bash
set -Eeuo pipefail
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
root="$repo/.state/wisp-go"
revision="${WISP_SMOKE_REV:?Provide pinned Smoke revision}"
action="${1:?Provide build, check, qualify or forward}"
[[ "$revision" =~ ^[a-f0-9]{40}$ ]] || { echo 'Invalid Smoke revision' >&2; exit 1; }
mkdir -p "$root"
chmod 700 "$root"
case "$action" in
  build|check|linux)
    [[ "${NIX_XD_PROVIDER:-podman}" == podman ]] || { echo 'Wisp Go owner adapter requires Podman' >&2; exit 1; }
    runtime=(podman)
    [[ "$(uname -s)" != Darwin ]] || runtime+=(--connection "${NIX_XD_MACHINE:?Provide machine}")
    owner="${NIX_XD_SCOPE:?Provide owner scope}"
    flake="${NIX_XD_WORKLOAD_FLAKE:-/workspaces/nix.xd}"
    case "$(uname -s)" in Darwin) target_os=darwin ;; Linux) target_os=linux ;; *) echo 'Unsupported host OS' >&2; exit 1 ;; esac
    case "$(uname -m)" in arm64|aarch64) target_arch=arm64 ;; x86_64|amd64) target_arch=amd64 ;; *) echo 'Unsupported host architecture' >&2; exit 1 ;; esac
    [[ "$action" != linux ]] || target_os=linux
    owner_root=/nix/home/nixuser/.local/state/nix-xd/wisp-go/$revision
    # The flake lock selects the toolchain; only pinned Smoke source enters this workspace.
    "${runtime[@]}" exec -i "$owner" nix shell --no-write-lock-file "$flake#wispGoTools" --command bash -se -- "$action" "$revision" "$target_os" "$target_arch" "$owner_root" <<'OWNER'
set -Eeuo pipefail
action=$1 revision=$2 target_os=$3 target_arch=$4 root=$5
mkdir -p "$root"
if [[ ! -d "$root/source/.git" ]]; then
  git clone --no-checkout https://github.com/xd-dash/smoke.git "$root/source"
  git -C "$root/source" checkout --detach "$revision"
fi
cd "$root/source"
[[ "$(git rev-parse HEAD)" == "$revision" ]] || { echo 'Cached owner Smoke source pins another revision' >&2; exit 1; }
git diff --quiet HEAD --
[[ -z "$(git ls-files --others --exclude-standard)" ]] || { echo 'Owner Smoke source has untracked files' >&2; exit 1; }
if [[ "$action" == check ]]; then
  go vet ./...
  WISP_REQUIRE_UNIX=1 go test -race -count=1 ./...
  echo WISP_GO_OWNER_CHECK_RESULT=passed
else
  export GOOS="$target_os" GOARCH="$target_arch" CGO_ENABLED=0
  go build -o "$root/smoke-$target_os-$target_arch" ./cmd/smoke-wisp
  go test -c -o "$root/wisp-test-$target_os-$target_arch" ./wisp
fi
OWNER
    if [[ "$action" == linux ]]; then
      store_path="$("${runtime[@]}" exec "$owner" sh -ec '
        path=$(nix-store --add "$1")
        nix-store --realise --add-root "$2" "$path" >/dev/null
        printf "%s\n" "$path"
      ' retain "$owner_root/smoke-linux-$target_arch" "$owner_root/guest-smoke-root")"
      [[ "$store_path" =~ ^/nix/store/[a-z0-9]{32}-smoke-linux-(arm64|amd64)$ ]] || { echo 'Invalid guest Smoke output' >&2; exit 1; }
      printf '%s\n' "$store_path" > "$root/linux-path"
      printf '%s\n' "$revision" > "$root/linux-revision"
      echo WISP_GO_LINUX_BUILD_RESULT=passed
    elif [[ "$action" == check ]]; then
      [[ -x "$root/wisp.test" && -r "$root/revision" && "$(cat "$root/revision")" == "$revision" ]] || { echo 'Run wisp-go-build before checking host sockets' >&2; exit 1; }
      WISP_REQUIRE_UNIX=1 "$root/wisp.test" -test.v
      echo WISP_GO_CHECK_RESULT=passed
    else
      candidate="$(mktemp "$root/smoke.XXXXXX")"
      test_candidate="$(mktemp "$root/wisp-test.XXXXXX")"
      trap 'rm -f "$candidate" "$test_candidate"' EXIT
      "${runtime[@]}" exec "$owner" cat "$owner_root/smoke-$target_os-$target_arch" > "$candidate"
      "${runtime[@]}" exec "$owner" cat "$owner_root/wisp-test-$target_os-$target_arch" > "$test_candidate"
      chmod 700 "$candidate" "$test_candidate"
      mv "$candidate" "$root/smoke"
      mv "$test_candidate" "$root/wisp.test"
      printf '%s\n' "$revision" > "$root/revision"
      echo WISP_GO_BUILD_RESULT=passed
    fi
    ;;
  qualify|forward)
    [[ -x "$root/smoke" && -r "$root/revision" && "$(cat "$root/revision")" == "$revision" ]] || { echo 'Run wisp-go-build first' >&2; exit 1; }
    state="${COREOS_STATE_ROOT:-$repo/.state/coreos}/${COREOS_PROFILE:-starwisp}"
    port="${COREOS_SSH_PORT:-2222}"
    [[ -r "$state/manifest.txt" && -r "$state/known_hosts" ]] || { echo 'Existing boot manifest and trusted known_hosts are required' >&2; exit 1; }
    grep -Fxq "port=$port" "$state/manifest.txt" || { echo 'SSH port does not match boot manifest' >&2; exit 1; }
    options=(--address "127.0.0.1:$port" --user "${COREOS_GUEST_USER:-wisp}" --identity "${COREOS_SSH_KEY:?Provide COREOS_SSH_KEY}" --known-hosts "$state/known_hosts")
    if [[ "$action" == qualify ]]; then
      exec "$root/smoke" wisp qualify "${options[@]}" --timeout 2m
    fi
    exec "$root/smoke" wisp forward "${options[@]}" --listen "$root/fatline-vm1.sock" --target-network tcp --target 127.0.0.1:16379 --timeout 10m
    ;;
  *) echo 'Unknown Wisp Go action' >&2; exit 1 ;;
esac
