#!/usr/bin/env bash
set -Eeuo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
machine="${NIX_XD_MACHINE:-coreos-arm64}"
image="${NIX_XD_IMAGE:-localhost/nix-xd:arm64}"
manifest="${NIX_XD_GRANTS_FILE:?Select credential volume grants}"
identity="${NIX_XD_CREDENTIAL_IDENTITY:?Select the existing CoreOS SSH identity}"
known_hosts="${NIX_XD_CREDENTIAL_KNOWN_HOSTS:?Select the pinned CoreOS known_hosts file}"
[[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 2
[[ "$image" =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || exit 2
[[ -f "$identity" && -r "$identity" && ! -L "$identity" ]] || { echo 'SSH identity not a readable regular file' >&2; exit 2; }
[[ -s "$known_hosts" && -r "$known_hosts" && ! -L "$known_hosts" ]] || { echo 'Known-hosts file not a readable regular file' >&2; exit 2; }
[[ "$(stat -f %Lp "$identity")" == 600 || "$(stat -f %Lp "$identity")" == 400 ]] ||
  { echo 'SSH key must be 0600 or 0400 on macOS' >&2; exit 2; }
volume="$(python3 "$repo/lib/runtime_grants.py" fixture "$manifest" | awk '{print $1}')"
[[ "$volume" == nix-xd-state-secret-*-ssh-qualification ]] ||
  { echo 'Only dedicated SSH qualification secret volumes may be imported' >&2; exit 2; }
p=(podman --connection "$machine")
[[ "$(podman machine inspect "$machine" --format '{{.State}}')" == running ]] || exit 1
"${p[@]}" image exists "$image" || { echo 'Selected cached image missing' >&2; exit 1; }
labels="$("${p[@]}" volume inspect "$volume" --format '{{json .Labels}}')"
python3 - "$volume" "$labels" <<'PY'
import json,re,sys
name=sys.argv[1]
labels=json.loads(sys.argv[2])
m=re.fullmatch(r"nix-xd-state-secret-([a-z][a-z0-9-]{0,39})",name)
if not m or not all((labels.get("io.nix-xd.state.version") == "1",
                     labels.get("io.nix-xd.state.kind") == "secret",
                     labels.get("io.nix-xd.state.name") == m.group(1))):
    raise SystemExit("Unrecognized credential volume labels")
PY

# This is a one-time explicit import. Never mutate or rotate existing credentials.
attached="$("${p[@]}" ps -aq)"
for id in $attached; do
  mounted="$("${p[@]}" inspect "$id" --format '{{range .Mounts}}{{if eq .Name "'$volume'"}}{{println .Destination}}{{end}}{{end}}')"
  [[ -z "$mounted" ]] || { echo "Credential volume already attached: $id" >&2; exit 1; }
done
expected="$(shasum -a 256 "$identity" | awk '{print $1}')"
expected_hosts="$(shasum -a 256 "$known_hosts" | awk '{print $1}')"

metadata() {
  "${p[@]}" run --rm --pull=never --network none --user 0:0 \
    --volume "$volume:/ssh:z" --entrypoint /bin/sh "$image" -ec '
      for path in /ssh /ssh/identity /ssh/known_hosts; do
        if [ -e "$path" ]; then
          stat -c "CREDENTIAL_PATH path=%n uid=%u gid=%g mode=%a" "$path"
        fi
      done
    '
}
root_digest() {
  local file="$1"
  "${p[@]}" run --rm --pull=never --network none --read-only --user 0:0 \
    --volume "$volume:/ssh:ro,z" --entrypoint /bin/sh "$image" -ec \
    "sha256sum /ssh/$file | cut -d ' ' -f1"
}
reader_digest() {
  local file="$1"
  "${p[@]}" run --rm --pull=never --network none --read-only --user 1000:1000 --cap-drop all \
    --volume "$volume:/ssh:ro,z" --entrypoint /bin/sh "$image" -ec \
    "sha256sum /ssh/$file | cut -d ' ' -f1"
}
verify_root_hashes() {
  [[ "$(root_digest identity)" == "$expected" ]] ||
    { echo 'Stored SSH identity differs from selected source; refusing changes' >&2; exit 1; }
  [[ "$(root_digest known_hosts)" == "$expected_hosts" ]] ||
    { echo 'Stored known_hosts differs from selected source; refusing changes' >&2; exit 1; }
}
normalize_owner() {
  "${p[@]}" run --rm --pull=never --network none --user 0:0 \
    --volume "$volume:/ssh:z" --entrypoint /bin/sh "$image" -ec '
      test -f /ssh/identity && test -f /ssh/known_hosts || exit 1
      chown 1000:1000 /ssh /ssh/identity /ssh/known_hosts
      chmod 0700 /ssh
      chmod 0600 /ssh/identity
      chmod 0644 /ssh/known_hosts
    '
}
present="$("${p[@]}" run --rm --pull=never --network none --read-only --user 0:0 \
  --volume "$volume:/ssh:ro,z" --entrypoint /bin/sh "$image" -ec '
    if [ -z "$(ls -A /ssh)" ]; then echo empty;
    elif [ -f /ssh/identity ] && [ -f /ssh/known_hosts ] &&
         [ "$(ls -A /ssh | wc -l)" -eq 2 ]; then echo populated;
    else echo unexpected; fi
  ')"
case "$present" in
  empty)
    "${p[@]}" run --rm --pull=never --network none --user 0:0 \
      --volume "$volume:/ssh:z" --entrypoint /bin/sh "$image" -ec '
        test -z "$(ls -A /ssh)" || exit 1
        chown 1000:1000 /ssh
        chmod 0700 /ssh
      '
    cid="$("${p[@]}" create --pull=never --network none --user 0:0 \
      --volume "$volume:/ssh:z" --entrypoint /bin/sh "$image" -ec 'true')"
    cleanup() {
      local rc=$?
      trap - EXIT
      "${p[@]}" rm -f "$cid" >/dev/null 2>&1 || rc=1
      exit "$rc"
    }
    trap cleanup EXIT
    "${p[@]}" cp "$identity" "$cid:/ssh/identity"
    "${p[@]}" cp "$known_hosts" "$cid:/ssh/known_hosts"
    "${p[@]}" start -a "$cid" >/dev/null
    "${p[@]}" rm "$cid" >/dev/null
    trap - EXIT
    verify_root_hashes
    normalize_owner
    ;;
  populated)
    [[ "${NIX_XD_CREDENTIAL_RECONCILE:-0}" == 1 ]] ||
      { echo 'Existing credential files; set CREDENTIAL_RECONCILE=1 to verify and repair ownership without replacing them' >&2; exit 1; }
    verify_root_hashes
    normalize_owner
    ;;
  *)
    echo 'Unexpected credential volume contents; refusing import or reconciliation' >&2
    exit 1
    ;;
esac
metadata
# The unprivileged reader must traverse the directory and read both files.
actual="$(reader_digest identity)" || {
  echo 'CREDENTIAL_READER=denied path=identity; inspect ownership and SELinux policy' >&2
  exit 1
}
[[ "$actual" == "$expected" ]] || { echo 'SSH identity reader digest mismatch' >&2; exit 1; }
actual_hosts="$(reader_digest known_hosts)" || {
  echo 'CREDENTIAL_READER=denied path=known_hosts; inspect ownership and SELinux policy' >&2
  exit 1
}
[[ "$actual_hosts" == "$expected_hosts" ]] || { echo 'Known-hosts reader digest mismatch' >&2; exit 1; }
echo 'CREDENTIAL_VOLUME_IMPORT=passed key_mode=0600 known_hosts=verified'
