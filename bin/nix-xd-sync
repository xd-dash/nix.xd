#!/usr/bin/env python3
"""Immutable staging checkout sync using a shared Git object store."""
import pathlib
import re
import subprocess
import sys

def fail(msg):
    raise SystemExit(f"Sync error: {msg}")
def git(*args, check=True):
    return subprocess.run(["git", *map(str, args)], text=True, capture_output=True, check=check)
if len(sys.argv) != 6:
    fail("Expected REPO BRANCH WORKSPACES SYNC_NAME REV")
repo, branch, root_s, name, rev = sys.argv[1:]
if not re.fullmatch(r"[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+", repo):
    fail("Invalid REPO")
if not re.fullmatch(r"[A-Za-z0-9_.-]+(/[A-Za-z0-9_.-]+)*", name) or ".." in name:
    fail("Unsafe SYNC_NAME")
if rev and not re.fullmatch(r"[a-f0-9]{40}", rev):
    fail("REV must be full SHA")
if git("check-ref-format", "--branch", branch, check=False).returncode:
    fail("Invalid BRANCH")
root = pathlib.Path(root_s).expanduser().resolve()
if not root.is_absolute():
    fail("Expected absolute WORKSPACES")
target = root / name
store = root / ".repos" / (repo.rsplit("/", 1)[-1] + ".git")
url = "https://github.com/" + repo + ".git"
store.parent.mkdir(parents=True, exist_ok=True)
if not store.exists():
    git("init", "--bare", "-q", store)
    git("--git-dir", store, "remote", "add", "origin", url)
def sg(*args, check=True):
    return git("--git-dir", store, *args, check=check)
if sg("remote", "get-url", "origin").stdout.strip() != url:
    fail("Canonical store origin mismatch")
sg("config", "remote.origin.fetch", "+refs/heads/*:refs/remotes/origin/*")
sg("fetch", "origin", "+refs/heads/*:refs/remotes/origin/*")
reference = sg("rev-parse", "--verify", "refs/remotes/origin/" + branch + "^{commit}").stdout.strip()
if rev and reference != rev:
    fail("Revision mismatch")
if target.exists():
    if not (target / ".git").exists():
        fail("Destination is not a Git checkout")
    original = git("-C", target, "remote", "get-url", "origin").stdout.strip()
    if original not in (url, "git@github.com:" + repo + ".git"):
        fail("Existing checkout origin mismatch")
    if git("-C", target, "status", "--porcelain").stdout:
        fail("Existing checkout is dirty")
    actual = git("-C", target, "rev-parse", "HEAD").stdout.strip()
    if actual != reference:
        fail("Existing checkout does not match selected remote revision; refresh manually")
else:
    target.parent.mkdir(parents=True, exist_ok=True)
    sg("worktree", "add", "--detach", target, reference)
print(f"Synchronized {repo} {name} at {reference}")
