#!/usr/bin/env bash
set -euo pipefail

action="${1:?store-export or store-import required}"
provider="${NIX_XD_PROVIDER:-podman}"
machine="${NIX_XD_MACHINE:-podman-machine-default}"
cache="${NIX_XD_CACHE_DIR:-}"
scope="${NIX_XD_SCOPE:-nix-xd-arm}"
store_path="${NIX_XD_STORE_PATH:?STORE_PATH must be an existing /nix/store path}"

[[ "$action" == store-export || "$action" == store-import ]] ||
  { echo "Unsupported store copy action" >&2; exit 2; }
[[ "$provider" == container || "$provider" == podman ]] ||
  { echo "Unsupported provider" >&2; exit 2; }
[[ "$scope" =~ ^[a-z][a-z0-9-]{0,39}$ ]] ||
  { echo "Invalid scope" >&2; exit 2; }
[[ "$store_path" =~ ^/nix/store/[0-9a-z]{32}-[A-Za-z0-9+._-]+$ ]] ||
  { echo "STORE_PATH must be a single, absolute Nix store path" >&2; exit 2; }

[[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] ||
  { echo "Invalid Podman Machine" >&2; exit 2; }
if [[ -z "$cache" ]]; then
  if [[ "$provider" == podman ]]; then
    cache=/workspaces/.cache/nix
  else
    cache=/exchange/nix-cache
  fi
fi
[[ "$cache" == /workspaces/.cache/nix || "$cache" == /exchange/nix-cache ]] ||
  { echo "Unsupported cache location" >&2; exit 2; }

in_container() {
  if [[ "$provider" == podman && "$(uname -s)" == Darwin ]]; then
    podman --connection "$machine" exec "$scope" "$@"
  else
    "$provider" exec "$scope" "$@"
  fi
}

case "$action" in
  store-export)
    in_container /bin/bash -ec '
      set -euo pipefail
      mkdir -p "$2"
      test -w "$2"
      nix path-info "$1" >/dev/null
      nix copy --to "file://$2" "$1"
      echo "Published Nix closure: $1"
    ' bash "$store_path" "$cache"
    ;;
  store-import)
    in_container /bin/bash -ec '
      set -euo pipefail
      test -r "$2"
      # Local trusted producer, not a signed public substituter.
      nix copy --no-check-sigs --from "file://$2" "$1"
      nix path-info "$1" >/dev/null
      echo "Imported Nix closure: $1"
    ' bash "$store_path" "$cache"
    ;;
esac
