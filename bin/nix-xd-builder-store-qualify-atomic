#!/usr/bin/env bash
set -Eeuo pipefail

repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
mode=${1:-fresh}
[[ $mode == fresh || $mode == resume ]] || { echo "Expected fresh or resume" >&2; exit 2; }
scope=${NIX_XD_QUALIFY_SCOPE:-nix-xd-arm-atomic-qualify}
machine=${NIX_XD_MACHINE:?Select the existing Podman Machine}
system=${NIX_XD_SYSTEM:-aarch64-linux}
image=${NIX_XD_QUALIFY_IMAGE:-localhost/nix-xd:arm64-atomic-qualify}
authoritative="$scope-store"
chroot_a="$scope-grumble-chroot"
chroot_b="$scope-experiments-chroot"
specs="grumble=$chroot_a experiments=$chroot_b"
workspace_parent="$(dirname "$repo")"
checkout="$(basename "$repo")"
workload_flake="/workspaces/$checkout"

fail() { printf 'BUILDER_STORE_FRESH_RESULT=failed reason=%s\n' "$*" >&2; exit 1; }
[[ $(uname -s) == Darwin && $(uname -m) == arm64 ]] || fail 'requires-macos-arm64'
[[ ${NIX_XD_PROVIDER:-podman} == podman && $system == aarch64-linux ]] || fail 'requires-arm64-podman'
[[ $scope =~ ^[a-z][a-z0-9-]{0,39}$ && $scope == *-qualify ]] || fail 'qualification-scope-must-end-in-qualify'
[[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || fail 'invalid-machine'
[[ $image =~ ^[A-Za-z0-9][A-Za-z0-9._/:@-]*$ ]] || fail 'invalid-image'
[[ ${NIX_XD_PEER_STORES:-} == '' ]] || fail 'fresh-qualification-disallows-peer-volumes'
[[ ${NIX_XD_CHROOT_SELINUX:-keep} == keep ]] || fail 'fresh-qualification-requires-selinux-keep'
[[ ${BUILDER_CHROOT_NAMESPACE:-1} == 1 && ${BUILDER_CHROOT_SYSCALLS:-1} == 1 ]] || fail 'fresh-qualification-requires-namespace-and-syscalls'

# Complete static and profile preflight before touching the VM or any resources.
printf 'BUILDER_STORE_FRESH_PHASE=static\n'
make -C "$repo" --no-print-directory builder-store-profile-check
NIX_XD_SCOPE="$scope" NIX_XD_STORE_VOLUME="$authoritative" \
 NIX_XD_PEER_STORES='' BUILDER_CHROOT_STORES="$specs" \
 BUILDER_CHROOT_NAMESPACE=1 BUILDER_CHROOT_SYSCALLS=1 NIX_XD_CHROOT_SELINUX=keep \
 bash "$repo/bin/nix-xd-builder-store-profile" plan

[[ $(podman machine inspect "$machine" --format '{{.State}}') == running ]] ||
  fail 'selected-podman-machine-must-be-running'
podman_cmd=(podman --connection "$machine")
if [[ $mode == fresh ]]; then
  for volume in "$authoritative" "$chroot_a" "$chroot_b"; do
    if "${podman_cmd[@]}" volume exists "$volume"; then fail "qualification-volume-already-exists:$volume"; fi
  done
  if "${podman_cmd[@]}" image exists "$image"; then fail "qualification-image-already-exists:$image"; fi
else
  "${podman_cmd[@]}" volume exists "$authoritative" || fail 'resume-missing-authoritative-volume'
  "${podman_cmd[@]}" image exists "$image" || fail 'resume-missing-image'
  printf 'BUILDER_ATOMIC_PHASE=resume-prestart scope=%s machine=%s\n' "$scope" "$machine"
fi
if "${podman_cmd[@]}" container exists "$scope"; then fail "qualification-container-already-exists:$scope"; fi
if podman machine ssh "$machine" "test -e \$HOME/.config/containers/systemd/$scope.container"; then
  fail "qualification-quadlet-already-exists:$scope"
fi
printf "BUILDER_ATOMIC_PHASE=bootstrap scope=%s machine=%s\n" "$scope" "$machine"
common=(PROVIDER=podman ARCH=arm64 "MACHINE=$machine" "SCOPE=$scope"
  "STORE_VOLUME=$authoritative" "BUILDER_CHROOT_STORES=$specs"
  "PEER_STORES=" "IMAGE=$image" MACHINE_BOOTSTRAP=0
  "WORKSPACES=$workspace_parent" "CHECKOUT=$checkout" "WORKLOAD_FLAKE=$workload_flake"
  BUILDER_CHROOT_NAMESPACE=1 BUILDER_CHROOT_SYSCALLS=1 CHROOT_SELINUX=keep
  INITIAL_PROFILE=1 "INITIAL_CHROOT_STORES=$specs")

make -C "$repo" --no-print-directory bootstrap-builder-profile "${common[@]}"
before=$("${podman_cmd[@]}" inspect "$scope" --format '{{.Id}}')
[[ -n $before ]] || fail 'missing-container-after-bootstrap'

printf 'BUILDER_STORE_FRESH_PHASE=verify-mounts\n'
mounts=$("${podman_cmd[@]}" inspect "$scope" --format '{{range .Mounts}}{{println .Name .Destination .RW}}{{end}}')
for expected in "$authoritative /nix true" "$chroot_a /stores/grumble true" "$chroot_b /stores/experiments true"; do
  grep -Fxq "$expected" <<< "$mounts" || fail "missing-or-wrong-mount:$expected"
done
[[ $(grep -Ec ' /nix true$' <<< "$mounts") == 1 ]] || fail 'unexpected-authoritative-mount-count'
"${podman_cmd[@]}" exec "$scope" sh -ec '
  test "$(id -u)" -eq 1000
  test -f /nix/.nix-xd-direct-volume-v2
  test -w /stores/grumble
  test -w /stores/experiments
  test -f /stores/grumble/.nix-xd-chroot-v1
  test -f /stores/experiments/.nix-xd-chroot-v1
  grep -Eq "^CapEff:[[:space:]]+0+$" /proc/self/status
  grep -Eq "^Seccomp:[[:space:]]+2$" /proc/self/status
' || fail 'container-security-or-store-readiness'

# Confirm the complete declaration is in the original Quadlet, not in
# incrementally generated post-start drop-ins.
unit_text=$(podman machine ssh "$machine" "cat \$HOME/.config/containers/systemd/$scope.container")
for declaration in "Volume=$authoritative:/nix" \
  "Volume=$chroot_a:/stores/grumble" "Volume=$chroot_b:/stores/experiments" \
  "Unmask=/proc/*" "SeccompProfile="; do
  grep -Fq "$declaration" <<< "$unit_text" || fail "missing-initial-quadlet:$declaration"
done
if podman machine ssh "$machine" "test -d \$HOME/.config/containers/systemd/$scope.container.d"; then
  fail 'atomic-bootstrap-must-not-require-profile-dropins'
fi
printf 'BUILDER_ATOMIC_PHASE=security\n'
"${podman_cmd[@]}" exec "$scope" sh -ec '
  test "$(id -u)" -eq 1000
  grep -Eq "^CapEff:[[:space:]]+0+$" /proc/self/status
  grep -Eq "^Seccomp:[[:space:]]+2$" /proc/self/status
'
tool=$("${podman_cmd[@]}" exec "$scope" nix build --no-write-lock-file --print-out-paths --no-link "$workload_flake#builderPolicy")
[[ $tool =~ ^/nix/store/[a-z0-9]{32}-nix-xd-builder-policy$ ]] || fail "builder-policy-build-invalid"
"${podman_cmd[@]}" exec "$scope" "$tool/bin/nix-xd-builder-policy" probe || fail "builder-uts-probe-failed"
printf 'BUILDER_ATOMIC_PHASE=idempotence\n'
make -C "$repo" --no-print-directory bootstrap-builder-profile "${common[@]}"
after=$("${podman_cmd[@]}" inspect "$scope" --format '{{.Id}}')
[[ $before == "$after" ]] || fail "container-recreated-during-idempotence"
[[ $("${podman_cmd[@]}" inspect "$scope" --format '{{.State.Running}}') == true ]] || fail "container-not-running"
printf 'BUILDER_ATOMIC_PROFILE_RESULT=passed scope=%s machine=%s container=%s stores=3 initial_start=true idempotence=true\n' "$scope" "$machine" "$after"
printf 'BUILDER_ATOMIC_PROFILE_REV=%s\n' "$(git -C "$repo" rev-parse HEAD)"
