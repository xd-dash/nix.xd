#!/usr/bin/env bash
set -euo pipefail
machine="${NIX_XD_MACHINE:-podman-machine-default}"
scope="${NIX_XD_SCOPE:-nix-xd-smoke-podman}"
[[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 2
[[ "$scope" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || exit 2
[[ -n "${GITHUB_CLIENT_ID:-}" ]] || {
  echo "GITHUB_CLIENT_ID must be set to the public GitHub App client ID." >&2
  exit 2
}
# This command is deliberately NOT run through the log wrapper:
# an authorization user_code is a short-lived credential.
podman --connection "$machine" exec \
  --env "GITHUB_CLIENT_ID=$GITHUB_CLIENT_ID" \
  "$scope" nix develop /workspaces/nix-alpine/nix-alpine/toolbox#security \
  -c /workspaces/.smoke-state/bin/smoke ghxd auth
