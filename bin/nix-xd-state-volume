#!/usr/bin/env bash
set -Eeuo pipefail

action="${1:-}"
kind="${2:-}"
name="${3:-}"
machine="${NIX_XD_MACHINE:-coreos-arm64}"
image="${NIX_XD_STATE_EXPORT_IMAGE:-docker.io/library/alpine:3.23}"
fail() { printf 'error: %s\n' "$*" >&2; exit 2; }

[[ "$action" =~ ^(plan|provision|inspect|export)$ ]] || fail 'Usage: nix-xd-state-volume plan|provision|inspect|export control|vm|application|secret NAME [EXPORT_PATH]'
[[ "$kind" =~ ^(control|vm|application|secret)$ ]] || fail 'State kind must be control, vm, application or secret'
[[ "$name" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || fail 'Invalid state name'
[[ "$machine" =~ ^[a-zA-Z0-9][a-zA-Z0-9_.-]*$ ]] || fail 'Invalid machine name'
command -v podman >/dev/null 2>&1 || fail 'Podman is required'
volume="nix-xd-state-$kind-$name"
p=(podman --connection "$machine")
[[ "$(podman machine inspect "$machine" --format '{{.State}}')" == running ]] ||
  fail "Podman Machine $machine is not running; no resource inspection or mutation attempted"

exists() { "${p[@]}" volume exists "$volume"; }
labels_valid() {
  "${p[@]}" volume inspect "$volume" --format '{{json .Labels}}' |
    python3 -c 'import json,sys
labels=json.load(sys.stdin) or {}
sys.exit(0 if labels.get("io.nix-xd.state.version")=="1" and
                labels.get("io.nix-xd.state.kind")==sys.argv[1] and
                labels.get("io.nix-xd.state.name")==sys.argv[2] else 1)
' "$kind" "$name"
}
printf 'STATE_VOLUME action=%s machine=%s kind=%s name=%s volume=%s\n' "$action" "$machine" "$kind" "$name" "$volume"

case "$action" in
  plan)
    if exists; then
      labels_valid || fail 'Volume exists without matching ownership labels; refusing adoption'
      printf 'STATE_VOLUME_PLAN=existing\n'
    else
      printf 'STATE_VOLUME_PLAN=absent\n'
    fi
    ;;
  provision)
    if exists; then
      labels_valid || fail 'Volume exists without matching ownership labels; refusing adoption'
    else
      "${p[@]}" volume create \
        --label io.nix-xd.state.version=1 \
        --label "io.nix-xd.state.kind=$kind" \
        --label "io.nix-xd.state.name=$name" \
        "$volume" >/dev/null
      labels_valid || fail 'Created volume does not match requested ownership'
    fi
    printf 'STATE_VOLUME_PROVISION=passed volume=%s\n' "$volume"
    ;;
  inspect)
    exists || fail 'Volume not found'
    labels_valid || fail 'Volume ownership does not match request'
    "${p[@]}" volume inspect "$volume"
    printf 'STATE_VOLUME_INSPECT=passed volume=%s\n' "$volume"
    ;;
  export)
    [[ $# == 4 ]] || fail 'export requires an explicit destination TAR path'
    exists || fail 'Volume not found'
    labels_valid || fail 'Volume ownership does not match request'
    destination="$4"
    [[ -n "$destination" && "$destination" == /* ]] || fail 'Export destination must be absolute'
    [[ ! -e "$destination" ]] || fail 'Export destination already exists'
    [[ -d "$(dirname "$destination")" ]] || fail 'Export parent directory does not exist'
    [[ ! -L "$(dirname "$destination")" ]] || fail 'Export parent must not be a symlink'
    umask 077
    tmp="$(mktemp "${destination}.tmp.XXXXXX")"
    trap 'rm -f "$tmp"' EXIT
    "${p[@]}" run --rm --pull=never --network none --read-only \
      --mount "type=volume,src=$volume,dst=/state,ro" \
      --entrypoint /bin/tar "$image" -C /state -cf - . > "$tmp"
    mv -n "$tmp" "$destination"
    [[ ! -e "$tmp" ]] || fail "Destination appeared during export; retained existing file"
    trap - EXIT
    printf 'STATE_VOLUME_EXPORT=passed volume=%s archive=%s\n' "$volume" "$destination"
    ;;
esac
