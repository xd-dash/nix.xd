#!/usr/bin/env bash
set -Eeuo pipefail

machine="${NIX_XD_MACHINE:-podman-machine-default}"
scope="${NIX_XD_SCOPE:-nix-xd-smoke-podman}"
flake=/workspaces/nix-alpine/nix-alpine/toolbox#security

if [[ -n "${GITHUB_CLIENT_ID:-}" ]]; then
  client_id="$GITHUB_CLIENT_ID"
else
  # The macOS host is only a Podman transport. Both gh and the auth
  # session run in the Nix-provided guest toolchain.
  if ! podman --connection "$machine" exec "$scope" \
      nix develop "$flake" -c gh auth status --hostname github.com >/dev/null 2>&1; then
    [[ -r /dev/tty && -w /dev/tty ]] || {
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=guest-gh-auth-needs-tty' >&2
      exit 2
    }
    echo 'GHXD_CLIENT_ID_SETUP=guest-gh-auth (interaction excluded from log)' >&2
    podman --connection "$machine" exec -it "$scope" \
      nix develop "$flake" -c gh auth login \
        --hostname github.com --git-protocol https --web \
        </dev/tty >/dev/tty 2>/dev/tty || {
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=guest-gh-auth-failed' >&2
      exit 2
    }
  fi
  if ! client_id="$(podman --connection "$machine" exec "$scope" \
    nix develop "$flake" -c gh variable get APP_CLIENT_ID \
      --repo xd-dash/huram-abi-master 2>/dev/null)"; then
    echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=huram-abi-master-actions-variable' >&2
    exit 2
  fi
fi

[[ "$client_id" =~ ^[A-Za-z0-9_.-]{4,128}$ ]] || {
  echo 'GHXD_CLIENT_ID=INVALID reason=format' >&2
  exit 2
}
printf '%s\n' "$client_id"
