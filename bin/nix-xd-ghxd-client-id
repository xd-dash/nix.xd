#!/usr/bin/env bash
set -Eeuo pipefail

machine="${NIX_XD_MACHINE:-podman-machine-default}"
scope="${NIX_XD_SCOPE:-nix-xd-smoke-podman}"
flake=/workspaces/nix-alpine/nix-alpine/toolbox#security

if [[ -n "${GITHUB_CLIENT_ID:-}" ]]; then
  client_id="$GITHUB_CLIENT_ID"
else
  # The macOS host is only a Podman transport. Both gh and the auth
  # session run in the Nix-provided guest toolchain.
  if ! podman --connection "$machine" exec "$scope" \
      nix develop "$flake" -c gh auth status --hostname github.com >/dev/null 2>&1; then
    [[ -r /dev/tty && -w /dev/tty ]] || {
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=guest-gh-auth-needs-tty' >&2
      exit 2
    }
    echo 'GHXD_CLIENT_ID_SETUP=guest-gh-auth (interaction excluded from log)' >&2
    podman --connection "$machine" exec -it "$scope" \
      nix develop "$flake" -c gh auth login \
        --hostname github.com --git-protocol https --web \
        </dev/tty >/dev/tty 2>/dev/tty || {
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=guest-gh-auth-failed' >&2
      exit 2
    }
  fi
  # Use the GitHub REST endpoint directly so a failed lookup can be
  # classified without printing tokens or the complete API response.
  local_error="$(mktemp)"
  trap 'rm -f "$local_error"' EXIT
  if ! client_id="$(podman --connection "$machine" exec "$scope" \
      nix develop "$flake" -c gh api \
        repos/xd-dash/huram-abi-master/actions/variables/APP_CLIENT_ID \
        --jq .value 2>"$local_error")"; then
    if grep -Eq 'HTTP 404|status: 404|Not Found' "$local_error"; then
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=repo-variable-not-found-or-inaccessible http=404' >&2
    elif grep -Eq 'HTTP 403|status: 403|Resource not accessible' "$local_error"; then
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=repo-variable-permission-denied http=403' >&2
    elif grep -Eq 'HTTP 401|status: 401|Bad credentials' "$local_error"; then
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=guest-github-auth-rejected http=401' >&2
    else
      echo 'GHXD_CLIENT_ID=UNAVAILABLE reason=repo-variable-request-failed (redacted)' >&2
    fi
    exit 2
  fi
fi

[[ "$client_id" =~ ^[A-Za-z0-9_.-]{4,128}$ ]] || {
  echo 'GHXD_CLIENT_ID=INVALID reason=format' >&2
  exit 2
}
printf '%s\n' "$client_id"
