#!/usr/bin/env bash
set -Eeuo pipefail
[[ ${NIX_XD_PROVIDER:-podman} == podman ]] || exit 2
scope=${NIX_XD_SCOPE:?scope}
[[ $scope =~ ^[a-z][a-z0-9-]{0,39}$ ]] || exit 2
repo="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
podman_cmd=(podman)
if [[ $(uname -s) == Darwin ]]; then
  machine=${NIX_XD_MACHINE:?machine}
  [[ $machine =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 2
  podman_cmd+=(--connection "$machine")
fi
before=$("${podman_cmd[@]}" inspect "$scope" --format '{{.Id}}')
[[ -n $before ]] || { echo 'Builder is not running' >&2; exit 1; }
bash "$repo/bin/nix-xd-builder-store-profile" apply
after=$("${podman_cmd[@]}" inspect "$scope" --format '{{.Id}}')
[[ "$before" == "$after" ]] || {
  printf 'BUILDER_STORE_PROFILE_IDEMPOTENCE=failed before=%s after=%s\n' "$before" "$after" >&2
  exit 1
}
running=$("${podman_cmd[@]}" inspect "$scope" --format '{{.State.Running}}')
[[ "$running" == true ]] || { echo 'Builder is not running after reapply' >&2; exit 1; }
printf 'BUILDER_STORE_PROFILE_IDEMPOTENCE=passed owner=%s container=%s\n' "$scope" "$after"
