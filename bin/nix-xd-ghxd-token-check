#!/usr/bin/env bash
set -euo pipefail
machine="${NIX_XD_MACHINE:-podman-machine-default}"
scope="${NIX_XD_SCOPE:-nix-xd-smoke-podman}"
reader="${NIX_XD_READER_SCOPE:-$scope-reader}"
[[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || exit 2
for runner in "$scope" "$reader"; do
  [[ "$runner" =~ ^[a-z][a-z0-9-]{0,39}$ ]] || exit 2
  printf 'GHXD_TOKEN_READ_GATE=%s START\n' "$runner"
  podman --connection "$machine" exec "$runner" \
    nix develop /workspaces/nix-alpine/nix-alpine/toolbox#security \
    -c /workspaces/.smoke-ghxd-state/bin/smoke ghxd-secrets status
  printf 'GHXD_TOKEN_READ_GATE=%s PASS\n' "$runner"
done
printf 'GHXD_TOKEN_CROSS_CONTAINER=PASS\n'
