#!/usr/bin/env bash
set -Eeuo pipefail
machine="${NIX_XD_MACHINE:-podman-machine-default}"
scope="${NIX_XD_SCOPE:-nix-xd-arm}"
volume="${NIX_XD_STORE_EXPORT_VOLUME:-$scope-store}"
image="${NIX_XD_IMAGE:-localhost/nix-xd:arm64}"
die() { printf 'error: %s\n' "$*" >&2; exit 1; }
[[ "$machine" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die 'Invalid machine'
[[ "$volume" =~ ^[A-Za-z0-9][A-Za-z0-9_.-]*$ ]] || die 'Invalid volume'
if [[ "$(uname -s)" == Darwin ]]; then
  [[ "$(podman machine inspect "$machine" --format '{{.State}}')" == running ]] || die 'Podman Machine not running'
  p=(podman --connection "$machine")
else
  [[ "$(uname -s)" == Linux ]] || die 'Unsupported host OS'
  p=(podman)
  machine=native-linux
fi
"${p[@]}" volume exists "$volume" || die "Nix store volume missing on $machine: $volume"
"${p[@]}" image exists "$image" || die "Nix-Alpine probe image missing on $machine: $image"
"${p[@]}" container exists "$scope" || die "Nix-Alpine store owner container is missing: $scope"
owner_volume="$("${p[@]}" inspect "$scope" --format '{{range .Mounts}}{{if eq .Destination "/nix"}}{{.Name}}{{end}}{{end}}')"
[[ "$owner_volume" == "$volume" ]] || die "Nix-Alpine /nix expected volume $volume, got $owner_volume"
"${p[@]}" exec "$scope" /bin/sh -ec '
  test -d /nix/store && test -d /nix/var/nix
  test -f /nix/.nix-xd-direct-volume-v2
  grep -Eq " /nix rw(,| )" /proc/self/mountinfo || exit 1
  test -x /nix/home/nixuser/.nix-profile/bin/nix
  nix --version
  nix store info >/dev/null
' || die "Nix-Alpine owner store not ready or not writable"
printf 'NIX_STORE_OWNER_READY machine=%s scope=%s volume=%s mode=read-write\n' "$machine" "$scope" "$volume"
# Use the same rootless Podman volume mapping as a guest VM runner. Never chown or
# recursively chmod the store to make an exporter work.
for user in 0:0 1000:1000; do
  echo "STORE_EXPORT_PROBE user=$user machine=$machine volume=$volume"
  "${p[@]}" run --rm --pull=never --user "$user" \
    --mount "type=volume,src=$volume,dst=/host-nix,ro" \
    --entrypoint /bin/sh "$image" -ec '
      test -d /host-nix/store || { echo "Missing store directory" >&2; exit 21; }
      test -r /host-nix/store || { echo "Store directory not readable" >&2; exit 22; }
      test -x /host-nix/store || { echo "Store directory not traversable" >&2; exit 23; }
      test -d /host-nix/var/nix || { echo "Nix metadata directory missing" >&2; exit 24; }
      grep -Eq " /host-nix ro(,| )" /proc/self/mountinfo ||
        { echo "Nix volume mount is not explicitly read-only" >&2; exit 25; }
    ' || die "Read-only Nix volume probe failed for container UID $user"
done
echo "NIX_STORE_EXPORT_READY machine=$machine volume=$volume image=$image mode=read-only"
